{
  "name": "gain-music-club",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "flock /tmp/wsl-webapp-build.lock sh -c \"vue-tsc --noEmit && vite build\"",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts && node scripts/test-isolated-sql.mjs",
    "lint": "eslint src tests scripts vite.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "security:check": "node scripts/security-check.mjs",
    "security:history": "node scripts/security-check.mjs --history",
    "verify": "pnpm security:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.1",
    "lucide-react": "0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "vue": "3.5.43",
    "vuetify": "4.2.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitejs/plugin-vue": "6.0.9",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.11.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vue-tsc": "3.1.1"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.x"
  }
}
